		(comment 1 "Merge of 'Four Motor Control Board M5' and 'Driver Board 2026-08-01'")
		(comment 2 "Both ESP32-S3 MCUs are retained; they meet only on the BoardCom pair")
	)
	(lib_symbols
	)
	(text "MASLOW MINI  -  MERGED CONTROL BOARD"
		(at 25 30 0)
		(effects
			(font
				(size 4.5 4.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "75e71ab6-c1c7-4205-a978-1a0a4cce98d3")
	)
	(text "One PCB.  Both ESP32-S3 MCUs are retained and meet only on the BoardCom pair below - everything else about the two"
		(at 25 38 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "f6a4620e-6544-4291-a9a1-6b11f82ff103")
	)
	(text "original circuits is unchanged, apart from the redundancy that a single board makes pointless."
		(at 25 44 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "0b028b89-cee1-4261-aa1c-98544736ad0c")
	)
	(text "The 2x5 board-to-board header (H1 on both boards) is gone.  Its four signal pins become the two BoardCom nets;"
		(at 25 53 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "8b16150d-2dfa-4af5-a834-bb8d51b442fd")
	)
	(text "its power pins (VIN x3, GND x3) become shared VIN and GND rails spanning both sections."
		(at 25 59 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "7c240f0b-c72b-4545-a37d-7b8b29dbf7f7")
	)
	(text "Each section still has its own ESP32-S3, its own USB-C programming port and its own boot button."
		(at 25 65 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "50793d87-8240-43e6-a80f-ad7c91ecdfcb")
	)
