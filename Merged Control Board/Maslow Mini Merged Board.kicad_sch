		(company "Maslow CNC")
		(comment 1 "Merge of 'Four Motor Control Board M5' and 'Driver Board 2026-08-01'")
		(comment 2 "Both ESP32-S3 MCUs are retained; they meet only on the BoardCom pair")
	)
	(lib_symbols
	)
	(text "MASLOW MINI  -  MERGED CONTROL BOARD"
		(at 25 30 0)
		(effects
			(font
				(size 4.5 4.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "75e71ab6-c1c7-4205-a978-1a0a4cce98d3")
	)
	(text "One PCB, the two original circuits kept intact side by side."
		(at 25 38 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "682d560d-5cce-415c-a07d-60e08046bca6")
	)
	(text "The 2x5 board-to-board header (H1 on both boards) is gone.  Its four signal pins become the two BoardCom nets below;"
		(at 25 46 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "fc7458ff-9b3e-48fd-ab5e-cb63c4d63230")
	)
	(text "its power pins (VIN x3, GND x3) become the shared VIN and GND rails, which now simply span both sections."
		(at 25 52 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "ea602480-c9de-4614-aba2-a0de12bb05a4")
	)
	(text "Everything else stays separate - in particular each section keeps its own ESP32-S3, its own USB-C port and its own 3.3 V regulator"
		(at 25 58 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "dfec742c-40cb-4407-a90c-0db90c42fdc3")
	)
	(text "(+3V3_MC and +3V3_DRV are two different nets)."
		(at 25 64 0)
		(effects
