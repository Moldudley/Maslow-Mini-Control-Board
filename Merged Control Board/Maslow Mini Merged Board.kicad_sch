		)
		(uuid "e9a7ae66-0604-49d0-a959-01ac03b9a35c")
	)
	(text "Shared across both sections:  VIN (XT60 input, was H1 pins 6/8/10)  and  GND (was H1 pins 5/7/9)."
		(at 25 165 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "69b59d99-6e9c-4dd2-a4b6-6b47fd35b11c")
	)
	(text "Renamed to stay separate:  3V3 -> +3V3_MC / +3V3_DRV,  BOOT -> BOOT_MC / BOOT_DRV."
		(at 25 172 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "30a22787-a481-4c91-ae6f-d0861fd86977")
	)
